end

local function getFishingFrame()
    local fishingGui = PlayerGui:FindFirstChild("FishingGui")
    if not fishingGui then return nil end
    return fishingGui:FindFirstChild("Fishing", true)
end

local function checkFishCount()
    local fishingFrame = getFishingFrame()
    local visible = fishingFrame ~= nil and isShown(fishingFrame)

    if visible then
        if not State.IsCharging then
            State.IsCharging = true
            State.FishCaught += 1
            print("[AutoFish] Fish counted:", State.FishCaught)
            updateUI()
        end
    else
        State.IsCharging = false
    end

    if SETTINGS.FishLimit > 0 and State.FishCaught >= SETTINGS.FishLimit then
        State.IsRunning = false
        State.Status = "Limit Reached!"
        FishToggle.Text = "START FISHING"
        FishToggle.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        updateUI()
        print("[AutoFish] Fish limit reached!")
        return true
    end
    return false
end

local function detectAndAct()
    if checkFishCount() then return end

    local castBtn = findCastButton()
    if castBtn then
        State.DetectedKey = "CAST"
        State.Status = "Casting..."
        updateUI()
        holdOnScreen(SETTINGS.CastHoldTime)
        if SETTINGS.CastCooldown > 0 then task.wait(SETTINGS.CastCooldown) end
        return
    end

    local fishingGui = getFishingGui()
    if not fishingGui then
        State.DetectedKey = "None"
        State.Status = "Waiting for bite..."
        updateUI()
        return
    end

    local tapMobile = getTapMobile(fishingGui)
    if tapMobile and isShown(tapMobile) then
        local keyAttr = tapMobile:GetAttribute("Key")
        if typeof(keyAttr) == "string" then keyAttr = string.upper(keyAttr) end

        if keyAttr and keyMap[keyAttr] then
            State.DetectedKey = keyAttr
            State.Status = "Spamming " .. keyAttr
            updateUI()
            pressKey(keyMap[keyAttr])
        else
            State.DetectedKey = "TAP"
            State.Status = "Spamming Tap"
            updateUI()
            clickObject(tapMobile)
        end

        if SETTINGS.TapCooldown > 0 then task.wait(SETTINGS.TapCooldown) end
        return
    end

    State.DetectedKey = "None"
    State.Status = "Waiting..."
    updateUI()
end

local function fishMainLoop()
    while State.IsRunning do
        updateTimer()
        local ok, err = pcall(detectAndAct)
        if not ok then
            warn("[AutoFish] Error:", err)
            State.Status = "Error"
            updateUI()
        end
        task.wait(SETTINGS.ScanInterval > 0 and SETTINGS.ScanInterval or 0)
    end
    State.DetectedKey = "None"
    updateUI()
end

-- ====================== CHEST LOGIC ======================

local chestsFolder = Workspace:WaitForChild("Chests", 10)

local function getCharacterParts()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")
    return character, hrp, humanoid
end

local function holdE(duration)
    ChestStatusLabel.Text = string.format("Status: Holding E (%.1fs)...", duration)
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
    task.wait(duration)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local function getTargetPart(item)
    return item:FindFirstChild("Root")
        or item:FindFirstChild("KeyHole")
        or item:FindFirstChild("Hitbox")
        or item:FindFirstChild("Main")
        or item:FindFirstChild("Chest")
        or (item:IsA("Model") and item.PrimaryPart)
        or item:FindFirstChildWhichIsA("BasePart", true)
end

local function tryOpenChest(item)
    local targetPart = getTargetPart(item)
    if not targetPart then
        ChestStatusLabel.Text = "Status: No part found in " .. item.Name
        return false
    end

    local _, rootPart, humanoid = getCharacterParts()
    if humanoid.Health <= 0 then return false end

    ChestStatusLabel.Text = "Status: Going to " .. item.Name
    rootPart.CFrame = targetPart.CFrame * CFrame.new(0, 3, 0)
    task.wait(0.4)

    local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        ChestStatusLabel.Text = "Status: Opening " .. item.Name
        if typeof(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
            task.wait(0.25)
        else
            rootPart.CFrame = targetPart.CFrame * CFrame.new(0, 2.5, 0)
            task.wait(0.15)
            holdE(math.max(prompt.HoldDuration, 0.8))
        end
    else
        holdE(1.2)
    end

    task.wait(0.4)
    return true
end

local function chestMainLoop()
    while State.ChestRunning do
        if not chestsFolder or not chestsFolder.Parent then
            ChestStatusLabel.Text = "Status: workspace.Chests missing!"
            break
        end

        local found = false
        for _, item in ipairs(chestsFolder:GetChildren()) do
            if not State.ChestRunning then break end
            if item:IsA("Model") or item:IsA("Folder") then
                found = true
                tryOpenChest(item)
            end
        end

        if not found then
            ChestStatusLabel.Text = "Status: Waiting for chests..."
            task.wait(2)
        else
            ChestStatusLabel.Text = "Status: Cycle done, looping..."
            task.wait(0.8)
        end
    end

    ChestStatusLabel.Text = "Status: Stopped"
    ChestToggle.Text = "START CHEST HUNTER"
    ChestToggle.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
    State.ChestRunning = false
end

-- ====================== MARKET VALUE LOOP ======================

task.spawn(function()
    local FishMarket = nil

    while not FishMarket do
        local success, result = pcall(function()
            local modules = ReplicatedStorage:FindFirstChild("Modules")
            return modules and require(modules:WaitForChild("FishMarket", 2))
        end)

        if success and result then
            FishMarket = result
        else
            MarketStatusLabel.Text = "Waiting for FishMarket module..."
            task.wait(2)
        end
    end

    MarketStatusLabel.Text = "Connected!"
    task.wait(0.5)

    while true do
        local success, currentMultiplier, timeRemaining = pcall(function()
            return FishMarket.Now()
        end)

        if success and currentMultiplier then
            MarketValueLabel.Text = ("%.4fx"):format(currentMultiplier)

            if FishMarket.BOOM and currentMultiplier >= FishMarket.BOOM then
                MarketValueLabel.TextColor3 = Color3.fromRGB(255, 205, 70)
                MarketStatusLabel.Text = "🔥 MARKET BOOM! SELL NOW!"
            elseif currentMultiplier >= 1.5 then
                MarketValueLabel.TextColor3 = Color3.fromRGB(110, 228, 120)
                MarketStatusLabel.Text = "Great price to sell!"
            elseif currentMultiplier >= 1.0 then
                MarketValueLabel.TextColor3 = Color3.fromRGB(160, 226, 150)
                MarketStatusLabel.Text = "Above normal price"
            else
                MarketValueLabel.TextColor3 = Color3.fromRGB(240, 104, 104)
                MarketStatusLabel.Text = "Low price: Hold fish"
            end

            if timeRemaining then
                MarketStatusLabel.Text = MarketStatusLabel.Text .. string.format(" (%d:%02d)", timeRemaining // 60, math.floor(timeRemaining % 60))
            end
        else
            MarketValueLabel.Text = "Error"
            MarketStatusLabel.Text = "Failed to fetch FishMarket.Now()"
        end

        task.wait(0.5)
    end
end)

