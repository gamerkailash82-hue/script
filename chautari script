    Minus.TextSize = 16
    Minus.Font = Enum.Font.GothamBold
    Minus.Parent = Row
    Instance.new("UICorner", Minus).CornerRadius = UDim.new(0, 6)

    local Val = Instance.new("TextBox")
    Val.Size = UDim2.fromOffset(48, 24)
    Val.Position = UDim2.new(1, -74, 0.5, -12)
    Val.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
    Val.Text = isWholeNumber and tostring(math.floor(SETTINGS[name])) or string.format("%.3f", SETTINGS[name])
    Val.TextColor3 = Color3.fromRGB(100, 220, 140)
    Val.TextSize = 12
    Val.Font = Enum.Font.GothamBold
    Val.TextXAlignment = Enum.TextXAlignment.Center
    Val.ClearTextOnFocus = false
    Val.Parent = Row
    Instance.new("UICorner", Val).CornerRadius = UDim.new(0, 6)

    local Plus = Instance.new("TextButton")
    Plus.Size = UDim2.fromOffset(24, 24)
    Plus.Position = UDim2.new(1, -24, 0.5, -12)
    Plus.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    Plus.Text = "+"
    Plus.TextColor3 = Color3.new(1, 1, 1)
    Plus.TextSize = 16
    Plus.Font = Enum.Font.GothamBold
    Plus.Parent = Row
    Instance.new("UICorner", Plus).CornerRadius = UDim.new(0, 6)

    local function refresh()
        Val.Text = isWholeNumber and tostring(math.floor(SETTINGS[name])) or string.format("%.3f", SETTINGS[name])
        saveSetting(name)
    end

    local function applyValue(text)
        local num = tonumber(text)
        if not num then
            refresh()
            return
        end
        if isWholeNumber then num = math.floor(num) end
        SETTINGS[name] = math.clamp(num, min, max)
        refresh()
    end

    Val.FocusLost:Connect(function()
        applyValue(Val.Text)
    end)

    Minus.MouseButton1Click:Connect(function()
        SETTINGS[name] = math.max(min, math.floor((SETTINGS[name] - step) * 1000 + 0.5) / 1000)
        refresh()
    end)

    Plus.MouseButton1Click:Connect(function()
        SETTINGS[name] = math.min(max, math.floor((SETTINGS[name] + step) * 1000 + 0.5) / 1000)
        refresh()
    end)

    settingRows[name] = refresh
end

